PORT=3000
NODE_ENV=development

# Local: Railway MySQL public TCP proxy host + port
# Railway service: ${{MySQL.MYSQLHOST}} and related references
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=railway

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seeded operator account (sign in on the web portal → /admin).
# Also used as a fallback recipient for payment-review emails.
# All users with role=admin receive those emails going forward.
ADMIN_EMAIL=admin@slam.com
ADMIN_PASSWORD=Password123

# Gmail SMTP (App Password). From-address for transactional mail.
EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_URL=

# Optional: defaults for payment accounts when SystemConfig rows are blank.
# Prefer editing these in web Admin → Config after deploy.
# EASYPAY_ACCOUNT=03300490019
# JAZZCASH_ACCOUNT=03300490019
# PAYMENT_ACCOUNT=03300490019

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Optional extra browser origins, comma-separated (Railway slam-web URL, LAN Vite, etc.)
CORS_ORIGINS=
